#!/usr/bin/env bash
#
# Copy everything the Voice app holds on the phone to this computer, and prove
# the copy is good before anything is allowed to touch the phone.
#
# This exists because on 2026-09-12 a Gradle instrumented-test run replaced the
# app on the phone; Android deletes an app's private *and* external data when the
# app is replaced, and a week of recordings and notes was destroyed. There was no
# backup.
#
# What is copied:
#   /data/data/<package>/files              the database, the config, the log
#   /data/data/<package>/shared_prefs       the settings (recorder, audio folder)
#   /storage/emulated/0/Android/data/<package>/files   the recordings
#   /storage/emulated/0/Recordings/Voice    the recordings, since Stage 13
#
# The Whisper models (files/whisper-models, over a gigabyte) are left out:
# they download again from Hugging Face, and copying them over wifi takes
# long enough for the connection to drop. VOICE_BACKUP_MODELS=1 keeps them.
#
# Both are deleted by an uninstall, so both are copied. The app must be a debug
# build (run-as needs it). Exits non-zero if anything is missing or the archive
# does not verify — so it can be used as a gate:
#
#   tools/voice-phone-backup && <the command that might destroy data>
#
set -euo pipefail

PACKAGE=${VOICE_PACKAGE:-com.dotancohen.voiceandroid}
WHERE=${1:-$HOME/voice-phone-backups}
STAMP=$(date +%Y-%m-%d-%H%M%S)
OUT="$WHERE/$PACKAGE-$STAMP"

say() { printf '%s\n' "$*"; }
die() { printf 'BACKUP FAILED: %s\n' "$*" >&2; exit 1; }

# Whether a directory exists on the phone: yes or no, and a dropped
# connection is neither, so it stops the backup instead of being taken for
# "the folder is not there".
phone_dir() {
    local answer
    answer=$(adb shell "if [ -d '$1' ]; then echo yes; else echo no; fi" 2>/dev/null | tr -d '\r') || die "the phone stopped answering (adb)"
    case "$answer" in
        yes) return 0 ;;
        no) return 1 ;;
        *) die "the phone stopped answering while checking $1" ;;
    esac
}

command -v adb >/dev/null || die "adb is not installed"
devices=$(adb devices | awk 'NR>1 && $2=="device" {print $1}')
[ -n "$devices" ] || die "no phone is connected (adb devices is empty)"
[ "$(printf '%s\n' "$devices" | wc -l)" -eq 1 ] || die "more than one device is connected; unplug one"

adb shell "pm list packages $PACKAGE" | grep -q "$PACKAGE" || die "$PACKAGE is not installed on the phone"
adb shell "run-as $PACKAGE true" >/dev/null 2>&1 || die "$PACKAGE is not debuggable, so its private data cannot be read"

mkdir -p "$OUT"
say "Backing up $PACKAGE to $OUT"

# --- the private data: database, config, log -------------------------------
# Piped through run-as and tar, because adb pull cannot read a private directory.
say "  private data (database, configuration, settings, log)"
EXCLUDE="--exclude=files/whisper-models"
MODELS_NOTE="left out (they download again)"
if [ "${VOICE_BACKUP_MODELS:-0}" = "1" ]; then
    EXCLUDE=""
    MODELS_NOTE="included"
fi
PRIVATE_DIRS=files
if adb shell "run-as $PACKAGE ls shared_prefs" >/dev/null 2>&1; then
    PRIVATE_DIRS="files shared_prefs"
fi
adb exec-out "run-as $PACKAGE tar -cf - -C /data/data/$PACKAGE $EXCLUDE $PRIVATE_DIRS" > "$OUT/private-files.tar" \
  || die "could not read the private data"

# --- the recordings -------------------------------------------------------
# Since Stage 13 recordings live in the shared Recordings/Voice folder, which
# survives the application; the application's own files directory is copied
# too, for recordings made before that.
AUDIO="/storage/emulated/0/Android/data/$PACKAGE/files"
SHARED="/storage/emulated/0/Recordings/Voice"
say "  recordings"
if phone_dir "$AUDIO" ; then
    adb exec-out "tar -cf - -C $(dirname "$AUDIO") $(basename "$AUDIO")" > "$OUT/external-files.tar" \
      || die "could not read the recordings"
else
    say "    (no external files directory on the phone)"
    : > "$OUT/external-files.tar"
fi
if phone_dir "$SHARED" ; then
    adb exec-out "tar -cf - -C $(dirname "$SHARED") $(basename "$SHARED")" > "$OUT/shared-recordings.tar" \
      || die "could not read the shared recordings folder"
else
    say "    (no Recordings/Voice folder on the phone)"
    : > "$OUT/shared-recordings.tar"
fi

# --- prove it ------------------------------------------------------------
say "Verifying"
# An empty file stands for a directory the phone said it does not have;
# anything else must read to its end.
for archive in "$OUT"/private-files.tar "$OUT"/external-files.tar "$OUT"/shared-recordings.tar; do
    [ -s "$archive" ] || continue
    tar -tf "$archive" >/dev/null 2>&1 || die "$archive is not a readable archive (cut off?)"
done
[ -s "$OUT/private-files.tar" ] || die "the private data archive is empty"

DB_ENTRY=$(tar -tf "$OUT/private-files.tar" | grep -c 'files/notes\.db$' || true)
[ "$DB_ENTRY" -ge 1 ] || die "the database is not in the archive"

# The database is worth nothing without its write-ahead log: a large -wal and a
# small notes.db is the normal state, and the notes live in the -wal.
WAL=$(tar -tf "$OUT/private-files.tar" | grep -c 'files/notes\.db-wal$' || true)
[ "$WAL" -ge 1 ] || say "    note: no notes.db-wal in the archive (the app may have checkpointed it)"

RECORDINGS=0
for archive in "$OUT"/external-files.tar "$OUT"/shared-recordings.tar; do
    [ -s "$archive" ] || continue
    RECORDINGS=$(( RECORDINGS + $(tar -tf "$archive" | grep -cE '\.(opus|m4a|wav|mp3|ogg)$' || true) ))
done
PRIVATE_BYTES=$(stat -c %s "$OUT/private-files.tar")
EXTERNAL_BYTES=$(( $(stat -c %s "$OUT/external-files.tar") + $(stat -c %s "$OUT/shared-recordings.tar") ))

cat > "$OUT/what-is-in-here.txt" <<EOF
Voice backup from the phone
  taken          $(date --iso-8601=seconds)
  package        $PACKAGE
  device         $devices
  private data   $PRIVATE_BYTES bytes (database, configuration, settings, log)
  whisper models $MODELS_NOTE
  recordings     $EXTERNAL_BYTES bytes, $RECORDINGS audio file(s)

To restore, with the app installed and stopped:
  adb exec-out run-as $PACKAGE tar -xf - -C /data/data/$PACKAGE < private-files.tar
  adb push --sync <extracted external files> /storage/emulated/0/Android/data/$PACKAGE/
  adb push --sync <extracted Voice folder> /storage/emulated/0/Recordings/
EOF

say ""
cat "$OUT/what-is-in-here.txt"
say "Backup verified."
