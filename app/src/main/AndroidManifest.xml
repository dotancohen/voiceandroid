<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Voice recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- On-device transcription runs as a foreground service with a progress notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- Recording carries on when the user leaves the app or locks the phone -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The recording being listened to stays in the notification drawer, and
         the process is not killed while it plays with the screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Internet permission for sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Finding peers on the local network (Stage 7): mDNS needs multicast -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Reading the code another device shows at pairing (Stage 9) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Storage permissions for audio files -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />
    <!-- Full storage access for Android 11+ (allows writing to any folder) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".VoiceApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceAndroid">

        <!--
          Sharing a recording hands the other application a content:// URI
          for that one file, granted for that one action. A plain file://
          path is refused by Android and would take the application down.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shared"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.VoiceAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A setup text is a link (Stage 9): tapped in any messaging app, it opens the pairing screen -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="voice" android:host="pair" />
            </intent-filter>
            <!-- Another application's share menu: text becomes a new note, an audio file a new note holding it -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Holds the microphone while the user is elsewhere. It keeps
             recording when the app is swiped out of the recent-apps list:
             the recording is stopped from its notification or by returning
             to the app, never by the phone tidying up. -->
        <service
            android:name=".audio.RecordingService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="microphone" />

        <!-- The recording being listened to, in the notification drawer, with
             Pause, Stop, and a tap that opens its note. stopWithTask="false"
             so swiping the app out of the recent-apps list does not cut off a
             recording that is still playing; Stop on the notification does. -->
        <service
            android:name=".audio.PlaybackService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Whisper running on the phone; stops itself when the queue is empty.
             stopWithTask="false" keeps it transcribing after the app is swiped
             out of the recent-apps list: the notification stays in the shade,
             with a Stop button, until the queue is empty. -->
        <service
            android:name=".transcription.TranscriptionService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaProcessing|dataSync" />

        <!-- The phone as a listener: other devices of the account may reach it
             to sync while this runs. Started only by the switch on the sync
             screen, stopped from its notification or the same switch. -->
        <service
            android:name=".data.SyncListenerService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <!-- Every sync operation runs here (Stage 4), with a progress
             notification and a Cancel action, so a long transfer survives
             the screen going off. The notification is the operation's own
             progress and disappears when it ends. -->
        <service
            android:name=".data.OperationService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
